{
  "manifest_version": 3,
  "name": "EnvFlow Local Environment",
  "version": "1.1.0",
  "description": "Switch local dev environments by injecting the X-Debug header on selected domains",
  "permissions": ["declarativeNetRequest", "storage", "activeTab"],
  "host_permissions": ["*://*.dev.clientDomain.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
